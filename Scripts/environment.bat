@echo off
rem Process-local configuration; no system PATH or environment changes.
set "AI_ROOT=%~dp0.."
for %%I in ("%AI_ROOT%") do set "AI_ROOT=%%~fI"
set "TEMP=%AI_ROOT%\Temp"
set "TMP=%AI_ROOT%\Temp"
set "PIP_CACHE_DIR=%AI_ROOT%\Temp\pip-cache"
set "PIP_INDEX_URL=https://pypi.org/simple"
set "PIP_NO_INDEX=0"
set "UV_CACHE_DIR=%AI_ROOT%\Temp\uv-cache"
set "UV_PYTHON_INSTALL_DIR=%AI_ROOT%\Tools\Python"
set "HF_HOME=%AI_ROOT%\Temp\huggingface"
set "HF_HUB_DISABLE_TELEMETRY=1"
set "DO_NOT_TRACK=1"
set "TORCH_HOME=%AI_ROOT%\Temp\torch"
set "XDG_CACHE_HOME=%AI_ROOT%\Temp\cache"
set "MPLCONFIGDIR=%AI_ROOT%\Temp\matplotlib"
set "CUDA_CACHE_PATH=%AI_ROOT%\Temp\cuda-cache"
set "PYTHONNOUSERSITE=1"
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"
set "PYTHONPATH="
