{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference.png"
    },
    "_meta": {
      "title": "Source image"
    }
  },
  "2": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1024,
      "height": 1024,
      "crop": "disabled"
    },
    "_meta": {
      "title": "Resize/upscale without extra model"
    }
  },
  "3": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Preview"
    }
  },
  "4": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "2",
        0
      ],
      "filename_prefix": "Upscale_Resize"
    },
    "_meta": {
      "title": "Save PNG"
    }
  }
}